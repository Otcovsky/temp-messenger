{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "server",
      "runtimeExecutable": "server/.venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "uvicorn", "app.main:app", "--app-dir", "server", "--host", "127.0.0.1", "--port", "8100", "--ws-max-size", "131072"],
      "port": 8100,
      "env": { "TM_PUSH_SUBJECT": "https://localhost" }
    },
    {
      "name": "client",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "client", "run", "dev", "--", "--host", "127.0.0.1"],
      "port": 5173,
      "url": "http://127.0.0.1:5173"
    },
    {
      "name": "client-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "client", "run", "preview", "--", "--host", "127.0.0.1", "--port", "4173", "--strictPort"],
      "port": 4173,
      "url": "http://127.0.0.1:4173"
    },
    {
      "name": "site",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "4180", "--bind", "127.0.0.1", "--directory", "site/dist"],
      "port": 4180,
      "url": "http://127.0.0.1:4180"
    }
  ]
}
